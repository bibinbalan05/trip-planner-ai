# Copy this file to `.env` (which is git-ignored) and fill in the values.
# Never commit a real API key.

# Required. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for chat. `gemini-flash-latest` always points at the newest Flash model.
GEMINI_MODEL=gemini-flash-latest

PORT=3000
NODE_ENV=development

# Allowed browser origin(s) for CORS. Separate several origins with commas.
# Must be an origin only (scheme + host + optional port), no path.
FRONTEND_ORIGIN=http://localhost:4200

# Optional tuning (defaults shown)
# GEMINI_TIMEOUT_MS=30000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
